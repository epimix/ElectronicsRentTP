@inject IFavService FavoriteService

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Equipment Rental</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ElectronicsRentTP.styles.css" asp-append-version="true" />
</head>

<body class="app-bg">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-gradient border-0 shadow-sm">
            <div class="container-xl">
                <a class="navbar-brand fw-semibold d-flex align-items-center gap-2" asp-area="" asp-controller="Home"
                    asp-action="Index">
                    <i class="bi bi-cpu-fill"></i>
                    <span>Equipment Rental</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index"><i
                                    class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Equipment" asp-action="Index"><i
                                    class="bi bi-grid me-1"></i>Equipment</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-area="" asp-controller="Favorite"
                                asp-action="Index">
                                <i class="bi bi-heart me-1"></i>Favorites
                                <span
                                    class="badge rounded-pill bg-danger ms-1 align-middle">@FavoriteService.GetFavSize()</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rentals" asp-action="MyBookings"><i
                                    class="bi bi-journal-text me-1"></i>My bookings</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm d-flex align-items-center gap-2"
                                asp-controller="Account" asp-action="Profile" title="Profile">
                                <i class="bi bi-person-circle"></i>
                                <span class="d-none d-sm-inline">Profile</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-xl">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-auto py-3">
        <div class="container-xl d-flex justify-content-between align-items-center small">
            <span>&copy; 2025 - Equipment Rental</span>
            <a class="link-secondary text-decoration-none" asp-area="" asp-controller="Home"
                asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ToastPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
