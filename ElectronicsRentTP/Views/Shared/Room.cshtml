@model DataAccess.Data.Entities.ChatRoom

@{
    ViewData["Title"] = "Chat";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier).Value;
    var partner = Model.OwnerId == userId ? Model.Renter : Model.Owner;
}

<style>
    /* ---------- MAIN WRAPPER ---------- */
    .chat-wrapper {
        max-width: 900px;
        margin: 30px auto;
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
        overflow: hidden;
        border: 1px solid #e2e8f0;
    }

    /* ---------- TOP BAR ---------- */
    .chat-topbar {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 14px 18px;
        background: linear-gradient(135deg, #6366f1, #3b82f6);
        color: #f9fafb;
    }

    .chat-topbar-exit a {
        background: rgba(15, 23, 42, 0.2);
        border: 1px solid rgba(15, 23, 42, 0.25);
        color: #f9fafb !important;
        padding: 4px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: 0.18s;
    }

        .chat-topbar-exit a:hover {
            background: rgba(15, 23, 42, 0.35);
            transform: translateX(-1px);
        }

    .chat-topbar-listing {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
        min-width: 0;
    }

        .chat-topbar-listing img {
            width: 58px;
            height: 58px;
            border-radius: 10px;
            object-fit: cover;
            border: 2px solid rgba(248, 250, 252, 0.45);
        }

    .chat-topbar-title-main {
        font-size: 1rem;
        font-weight: 600;
        white-space: nowrap;
        text-overflow: ellipsis;
        overflow: hidden;
    }

    .chat-topbar-title-link a {
        font-size: 0.82rem;
        color: #e5e7eb;
        text-decoration: underline;
    }

    .chat-topbar-avatar {
        text-align: center;
        min-width: 90px;
    }

        .chat-topbar-avatar img {
            width: 54px;
            height: 54px;
            border-radius: 999px;
            object-fit: cover;
            border: 2px solid rgba(248, 250, 252, 0.45);
            margin-bottom: 4px;
        }

        .chat-topbar-avatar div {
            font-size: 0.83rem;
            white-space: nowrap;
            text-overflow: ellipsis;
            overflow: hidden;
            max-width: 110px;
        }

    /* ---------- MESSAGES LIST ---------- */
    .chat-messages {
        height: 440px;
        overflow-y: auto;
        padding: 16px 14px;
        background: radial-gradient(circle at top left, #e0f2fe 0, #f1f5f9 38%, #f9fafb 100%);
        display: flex;
        flex-direction: column;
        gap: 10px;
        scroll-behavior: smooth;
    }

    .message-row {
        display: flex;
        align-items: flex-end;
        gap: 8px;
    }

        .message-row.mine {
            flex-direction: row-reverse;
        }

    .message-avatar {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        object-fit: cover;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
    }

    .message {
        max-width: 70%;
        padding: 9px 12px;
        border-radius: 14px;
        font-size: 0.93rem;
        line-height: 1.35rem;
        position: relative;
        word-wrap: break-word;
    }

        .message.mine {
            background: #4f46e5;
            color: #f9fafb;
            border-bottom-right-radius: 4px;
        }

        .message.theirs {
            background: #ffffff;
            color: #0f172a;
            border-bottom-left-radius: 4px;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.12);
        }

    .message-sender {
        font-weight: 600;
        font-size: 0.8rem;
        margin-bottom: 2px;
        opacity: 0.9;
    }

    .message-time {
        display: block;
        font-size: 0.72rem;
        margin-top: 3px;
        opacity: 0.7;
        text-align: right;
    }

    /* ---------- INPUT AREA ---------- */
    .chat-input-area {
        padding: 10px 14px 14px 14px;
        border-top: 1px solid #e5e7eb;
        background: #f9fafb;
        display: flex;
        gap: 10px;
    }

    #messageInput {
        flex-grow: 1;
        border-radius: 999px;
        border: 1px solid #d1d5db;
        padding-inline: 14px;
        padding-block: 8px;
        font-size: 0.95rem;
        outline: none;
        transition: 0.18s;
    }

        #messageInput:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(129, 140, 248, 0.35);
        }

    #sendButton {
        border-radius: 999px;
        padding-inline: 18px;
        font-weight: 500;
    }


    .chat-topbar {
        flex-wrap: wrap;
    }

    .chat-topbar-avatar {
        display: none;
    }

    .chat-messages {
        height: 380px;
    }

    }
</style>

<div class="chat-wrapper">

    <div class="chat-topbar">
        <!-- Кнопка виходу з чату -->
        <div class="chat-topbar-exit">
            <a asp-controller="Chat"
               asp-action="MyMessages">
                ← Back
            </a>
        </div>

        <!-- Інфо про оголошення -->
        <div class="chat-topbar-listing">
            <img src="@Model.Equipment.ImageUrl" alt="Listing" />

            <div style="min-width:0;">
                <div class="chat-topbar-title-main">
                    @Model.Equipment.Name
                </div>
                <div class="chat-topbar-title-link">
                    <a asp-controller="Equipment"
                       asp-action="Details"
                       asp-route-id="@Model.EquipmentId">
                        View listing →
                    </a>
                </div>
            </div>
        </div>

        <!-- Інфо про співрозмовника -->
        <div class="chat-topbar-avatar">
            <img src="@(partner.profilePicture ?? "https://cdn-icons-png.flaticon.com/512/149/149071.png")"
                 alt="User" />
            <div>@(partner.FullName ?? partner.Email)</div>
        </div>
    </div>

    <div id="messagesList" class="chat-messages">
        @foreach (var msg in Model.Messages.OrderBy(m => m.SentAt))
        {
            var mine = msg.SenderId == userId;
            <div class="message-row @(mine ? "mine" : "")">
                <img src="@(msg.Sender.profilePicture ?? "https://cdn-icons-png.flaticon.com/512/149/149071.png")"
                     class="message-avatar" />

                <div class="message @(mine ? "mine" : "theirs")">
                    <div class="message-sender">
                        @(msg.Sender.FullName ?? msg.Sender.Email)
                    </div>
                    @msg.Text
                    <span class="message-time">
                        @msg.SentAt.ToLocalTime().ToString("HH:mm")
                    </span>
                </div>
            </div>
        }
    </div>

    <div class="chat-input-area">
        <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." />
        <button id="sendButton" class="btn btn-primary">Send</button>
    </div>

</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const chatRoomId = @Model.Id;
        const userId = "@userId";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chathub")
            .withAutomaticReconnect()
            .build();

        function scrollToBottom() {
            const box = document.getElementById("messagesList");
            box.scrollTop = box.scrollHeight;
        }

        connection.on("ReceiveMessage", function (message) {
            const messagesList = document.getElementById("messagesList");

            const mine = message.senderId === userId;

            // Створюємо рядок повідомлення (без аватарки, бо з хаба не приходить url)
            const row = document.createElement("div");
            row.className = "message-row" + (mine ? " mine" : "");

            const bubble = document.createElement("div");
            bubble.className = "message " + (mine ? "mine" : "theirs");
            bubble.innerHTML =
                message.text +
                `<span class="message-time">${message.sentAt.slice(11, 16)}</span>`;

            row.appendChild(bubble);
            messagesList.appendChild(row);

            scrollToBottom();
        });

        connection.start()
            .then(function () {
                connection.invoke("JoinRoom", chatRoomId);
                scrollToBottom();
            })
            .catch(err => console.error(err));

        document.getElementById("sendButton").addEventListener("click", sendMessage);

        document.getElementById("messageInput").addEventListener("keyup", function (e) {
            if (e.key === "Enter") {
                sendMessage();
            }
        });

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const text = input.value.trim();
            if (text.length === 0) return;

            connection.invoke("SendMessage", chatRoomId, text)
                .catch(err => console.error(err));

            input.value = "";
        }
    </script>
}
