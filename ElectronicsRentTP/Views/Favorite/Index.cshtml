@model List<Equipment>

@{
    bool isEmpty = !Model.Any();
}

<h2 class="mb-4">Favorites</h2>

@if (isEmpty)
{
    <div class="alert alert-info">Your favorites list is empty.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Category?.Name</p>
                        <p class="card-text fw-bold">$@item.PricePerHour/hour</p>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            <form asp-controller="Favorite" asp-action="Delete" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-x-square"></i> Remove
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="mt-4 d-flex justify-content-between">
        <form asp-controller="Favorite" asp-action="DeleteAll" method="post">
            <button type="submit" class="btn btn-danger">Clear All Favorites</button>
        </form>
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue Browsing</a>
    </div>
}
