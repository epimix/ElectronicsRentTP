@model List<Equipment>
@{
    bool isEmpty = !Model.Any();
}

<h2>Favorites</h2>

<div class="card text-center">
    <div class="card-body">
        <h5 class="card-title">Favorite Equipment</h5>
        @if (!isEmpty)
        {
            <ol class="list-group list-group-numbered">
                @foreach (var i in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-bold">@i.Name</div>
                            <small class="text-muted">@i.Category?.Name - $@i.PricePerHour/hour</small>
                        </div>
                        <div>
                            @if (i.IsAvailable)
                            {
                                <span class="badge text-bg-success rounded-pill me-2">Available</span>
                            }
                            <a asp-controller="Favorite" asp-action="Delete" asp-route-id="@i.Id" class="text-danger">
                                <i class="bi bi-x-square"></i>
                            </a>
                        </div>
                    </li>
                }
            </ol>
            <div class="my-2">
                <a asp-controller="Favorite" asp-action="DeleteAll" class="text-danger text-decoration-none">
                    <i class="bi bi-x-square"></i> Clear All
                </a>
            </div>
        }
        else
        {
            <p>Your favorites list is empty.</p>
        }

        <div class="mt-3">
            @if (!isEmpty)
            {
                <button class="btn btn-success">Rent Selected</button>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Continue Browsing</a>
        </div>
    </div>
    <div class="card-footer text-body-secondary">
        Equipment count: @Model.Count
    </div>
</div>

