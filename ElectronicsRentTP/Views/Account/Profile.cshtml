@model ElectronicsRentTP.Models.UserProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6">
            @if (!Model.IsAuthenticated)
            {
                <div class="card shadow-sm border-0 text-center">
                    <div class="card-body p-4 p-md-5">
                        <div class="display-6 mb-3 text-danger"><i class="bi bi-person-x"></i></div>
                        <h4 class="mb-2">You're not signed in</h4>
                        <p class="text-muted mb-4">Please sign in to view your profile and bookings.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
                            </a>
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Sign up
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-circle bg-primary bg-gradient text-white d-flex align-items-center justify-content-center"
                                style="width:64px;height:64px;">
                                <i class="bi bi-person-fill" style="font-size: 1.75rem;"></i>
                            </div>
                            <div>
                                <h4 class="mb-1">@(Model.FullName ?? "User")</h4>
                                <div class="text-muted">@Model.Email</div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Full name</div>
                                    <div class="fw-semibold">@Model.FullName</div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Email</div>
                                    <div class="fw-semibold">@Model.Email</div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Date of birth</div>
                                    <div class="fw-semibold">@(Model.Birthdate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Roles</div>
                                    <div>
                                        @if (Model.Roles != null && Model.Roles.Count > 0)
                                        {
                                            foreach (var role in Model.Roles)
                                            {
                                                <span class="badge bg-secondary me-1">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">No roles</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <h5 class="mb-3">Quick Actions</h5>
                                <div class="d-grid gap-2">
                                    <a class="btn btn-outline-primary" asp-controller="Adverts" asp-action="Index" style="border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; transition: all 0.3s ease; border: 2px solid #667eea; color: #667eea;">
                                        <i class="bi bi-megaphone me-2"></i> My Adverts
                                    </a>
                                    <a class="btn btn-outline-primary" asp-controller="Rentals" asp-action="MyBookings" style="border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; transition: all 0.3s ease; border: 2px solid #667eea; color: #667eea;">
                                        <i class="bi bi-journal-text me-2"></i> My Bookings
                                    </a>
                                    <a class="btn btn-outline-primary" asp-controller="OwnerRentals" asp-action="Index" style="border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; transition: all 0.3s ease; border: 2px solid #667eea; color: #667eea;">
                                        <i class="bi bi-clipboard-check me-2"></i> Rental Requests
                                    </a>
                                    <a class="btn btn-outline-primary" asp-controller="Balance" asp-action="Index" style="border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; transition: all 0.3s ease; border: 2px solid #667eea; color: #667eea;">
                                        <i class="bi bi-wallet2 me-2"></i> Balance
                                    </a>
                                    <a class="btn btn-outline-primary" asp-controller="Cart" asp-action="Index" style="border-radius: 8px; padding: 0.75rem 1.5rem; font-weight: 600; transition: all 0.3s ease; border: 2px solid #667eea; color: #667eea;">
                                        <i class="bi bi-cart me-2"></i> Shopping Cart
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between flex-wrap gap-2">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="btn btn-danger">
                                    <i class="bi bi-box-arrow-right me-1"></i> Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
