@model List<DataAccess.Data.Entities.Complaint>

@{
    ViewData["Title"] = "Complaints";
}

<h2 class="mt-3 mb-4 text-center fw-bold">User Complaints</h2>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>From</th>
                    <th>Against</th>
                    <th>Rental</th>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Admin Comment</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Id</td>

                        <td>@c.Reporter?.Email</td>

                        <td>@c.TargetUser?.Email</td>

                        <td>@c.RentalId</td>

                        <td style="max-width:350px;">@c.Message</td>

                        <td>@c.Created.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>

                        <!-- Admin comment -->
                        <td style="min-width:200px;">
                            @if (string.IsNullOrWhiteSpace(c.AdminComment))
                            {
                                <span class="text-muted">No comment</span>
                            }
                            else
                            {
                                <span>@c.AdminComment</span>
                            }
                        </td>

                        <td class="text-center">
                            <div class="d-flex justify-content-center flex-wrap gap-2">

                                <a asp-action="Resolve"
                                   asp-route-id="@c.Id"
                                   class="btn btn-success btn-sm">
                                    ✓ Resolve
                                </a>

                                <a asp-action="BanUser"
                                   asp-route-id="@c.TargetUserId"
                                   class="btn btn-warning btn-sm">
                                    ⚠ Ban
                                </a>

                                <a asp-action="DeleteUser"
                                   asp-route-id="@c.TargetUserId"
                                   class="btn btn-danger btn-sm">
                                    ✖ Delete User
                                </a>

                                <a asp-action="DeleteAdvert"
                                   asp-route-id="@c.RentalId"
                                   class="btn btn-secondary btn-sm">
                                    🛈 Hide Listing
                                </a>

                                <a asp-action="Refund"
                                   asp-route-id="@c.RentalId"
                                   class="btn btn-info btn-sm text-white">
                                    ⟳ Refund
                                </a>

                                <!-- Add comment button -->
                                <button class="btn btn-outline-primary btn-sm"
                                        type="button"
                                        onclick="document.getElementById('comment-@c.Id').classList.toggle('d-none')">
                                    💬 Add comment
                                </button>
                            </div>

                            <!-- Inline comment form -->
                            <form asp-action="AddComment"
                                  method="post"
                                  class="mt-2 d-none"
                                  id="comment-@c.Id">

                                <input type="hidden" name="id" value="@c.Id" />

                                <textarea name="comment"
                                      class="form-control mb-2"
                                      placeholder="Enter admin comment">@c.AdminComment</textarea>

                                <button type="submit"
                                        class="btn btn-primary btn-sm">
                                    Save
                                </button>
                            </form>

                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
