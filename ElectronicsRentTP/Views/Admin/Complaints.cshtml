@model List<DataAccess.Data.Entities.Complaint>

@{
    ViewData["Title"] = "Admin - Complaints";
}

<style>
    .admin-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .admin-title {
        font-size: 2.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
    }

    .admin-subtitle {
        color: #718096;
        font-size: 1.1rem;
    }

    .complaints-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .complaints-table {
        margin: 0;
    }

        .complaints-table thead {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

            .complaints-table thead th {
                color: white;
                font-weight: 600;
                text-transform: uppercase;
                font-size: 0.875rem;
                letter-spacing: 0.5px;
                padding: 1.25rem 1rem;
                border: none;
                white-space: nowrap;
            }

        .complaints-table tbody tr {
            border-bottom: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }

            .complaints-table tbody tr:hover {
                background: #f7fafc;
            }

        .complaints-table tbody td {
            padding: 1rem;
            vertical-align: middle;
            color: #2d3748;
        }

    .user-email {
        color: #667eea;
        font-weight: 600;
    }

    .complaint-id {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 0.875rem;
        display: inline-block;
    }

    .message-text {
        max-width: 350px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .no-comment {
        color: #cbd5e0;
        font-style: italic;
    }

    .action-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
    }

    .btn-action {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.875rem;
        transition: all 0.3s ease;
        border: none;
        white-space: nowrap;
    }

    .btn-resolve {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(16, 185, 129, 0.3);
    }

        .btn-resolve:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
        }

    .btn-ban {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(245, 158, 11, 0.3);
    }

        .btn-ban:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
        }

    .btn-delete-user {
        background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
    }

        .btn-delete-user:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.4);
        }

    .btn-hide {
        background: #6b7280;
        color: white;
        box-shadow: 0 2px 8px rgba(107, 114, 128, 0.3);
    }

        .btn-hide:hover {
            background: #4b5563;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(107, 114, 128, 0.4);
        }

    .btn-refund {
        background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%);
        color: white;
        box-shadow: 0 2px 8px rgba(6, 182, 212, 0.3);
    }

        .btn-refund:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(6, 182, 212, 0.4);
        }

    .btn-comment {
        background: white;
        color: #667eea;
        border: 2px solid #667eea;
    }

        .btn-comment:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

    .comment-form {
        margin-top: 1rem;
        padding: 1rem;
        background: #f7fafc;
        border-radius: 12px;
        border: 2px solid #667eea;
    }

        .comment-form textarea {
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

            .comment-form textarea:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            }

    .btn-save-comment {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 0.5rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-save-comment:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
        }

    .date-badge {
        background: #f7fafc;
        padding: 0.375rem 0.875rem;
        border-radius: 8px;
        font-size: 0.875rem;
        color: #718096;
        font-weight: 600;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }

    .empty-icon {
        font-size: 5rem;
        margin-bottom: 1.5rem;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }
    }

    .empty-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #2d3748;
        margin-bottom: 0.75rem;
    }

    .empty-text {
        color: #718096;
        font-size: 1.1rem;
    }

    @@media (max-width: 1200px) {
        .complaints-container {
            overflow-x: auto;
        }

        .complaints-table {
            min-width: 1200px;
        }
    }
</style>

<div class="admin-header">
    <h1 class="admin-title">🛡️ Admin Dashboard</h1>
    <p class="admin-subtitle">Manage user complaints and take administrative actions</p>
</div>

@if (Model != null && Model.Any())
{
    <div class="complaints-container">
        <table class="table complaints-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Reporter</th>
                    <th>Target User</th>
                    <th>Rental</th>
                    <th>Message</th>
                    <th>Date</th>
                    <th>Admin Comment</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <span class="complaint-id">#@c.Id</span>
                        </td>

                        <td>
                            <span class="user-email">@c.Reporter?.Email</span>
                        </td>

                        <td>
                            <span class="user-email">@c.TargetUser?.Email</span>
                        </td>

                        <td>
                            <strong>#@c.RentalId</strong>
                        </td>

                        <td>
                            <div class="message-text" title="@c.Message">
                                @c.Message
                            </div>
                        </td>

                        <td>
                            <span class="date-badge">
                                @c.Created.ToLocalTime().ToString("MMM dd, HH:mm")
                            </span>
                        </td>

                        <td style="min-width:200px;">
                            @if (string.IsNullOrWhiteSpace(c.AdminComment))
                            {
                                <span class="no-comment">No comment</span>
                            }
                            else
                            {
                                <span>@c.AdminComment</span>
                            }
                        </td>

                        <td>
                            <div class="action-buttons">
                                <a asp-action="Resolve"
                                   asp-route-id="@c.Id"
                                   class="btn btn-action btn-resolve">
                                    <i class="bi bi-check-circle"></i> Resolve
                                </a>

                                <a asp-action="BanUser"
                                   asp-route-id="@c.TargetUserId"
                                   class="btn btn-action btn-ban">
                                    <i class="bi bi-exclamation-triangle"></i> Ban
                                </a>

                                <a asp-action="DeleteUser"
                                   asp-route-id="@c.TargetUserId"
                                   class="btn btn-action btn-delete-user">
                                    <i class="bi bi-trash"></i> Delete User
                                </a>

                                <a asp-action="DeleteAdvert"
                                   asp-route-id="@c.RentalId"
                                   class="btn btn-action btn-hide">
                                    <i class="bi bi-eye-slash"></i> Hide Listing
                                </a>

                                <a asp-action="Refund"
                                   asp-route-id="@c.RentalId"
                                   class="btn btn-action btn-refund">
                                    <i class="bi bi-arrow-counterclockwise"></i> Refund
                                </a>

                                <button class="btn btn-action btn-comment"
                                        type="button"
                                        onclick="document.getElementById('comment-@c.Id').classList.toggle('d-none')">
                                    <i class="bi bi-chat-left-text"></i> Comment
                                </button>
                            </div>

                            <form asp-action="AddComment"
                                  method="post"
                                  class="comment-form d-none"
                                  id="comment-@c.Id">

                                <input type="hidden" name="id" value="@c.Id" />

                                <textarea name="comment"
                                          class="form-control mb-2"
                                          rows="3"
                                          placeholder="Enter admin comment...">@c.AdminComment</textarea>

                                <button type="submit"
                                        class="btn btn-save-comment">
                                    <i class="bi bi-save"></i> Save Comment
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="complaints-container">
        <div class="empty-state">
            <div class="empty-icon">✅</div>
            <h3 class="empty-title">No Complaints</h3>
            <p class="empty-text">Great! There are no pending complaints at the moment.</p>
        </div>
    </div>
}