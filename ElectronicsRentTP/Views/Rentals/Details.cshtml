@model RentalDetailsViewModel
@{
    ViewData["Title"] = "booking details";
}
<h2>@ViewData["Title"]</h2>
<div class="card" style="max-width:900px;">
    <div class="card-body">
        <h5 class="card-title">@Model.EquipmentName</h5>
        @if (!string.IsNullOrEmpty(Model.EquipmentImageUrl))
        {
            <img src="@Model.EquipmentImageUrl" alt="image" style="max-width:200px; max-height:200px;" />
        }
        <p><strong>start:</strong> @Model.StartDate.ToString("g")</p>
        <p><strong>end:</strong> @Model.EndDate.ToString("g")</p>
        <p><strong>price:</strong> @Model.TotalPrice.ToString("0.00")</p>
        <p><strong>status:</strong> @Model.Status</p>
        <p><strong>user:</strong> @Model.UserEmail</p>


        <div class="mt-3">
            <a asp-action="MyBookings" class="btn btn-secondary">back</a>
        </div>
    </div>
</div>