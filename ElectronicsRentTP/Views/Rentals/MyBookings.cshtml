@model IEnumerable<RentalListItemViewModel>
@{
    ViewData["Title"] = "my bookings";
}
<h2>@ViewData["Title"]</h2>
<p>
    <a asp-action="Create" asp-controller="Rentals" class="btn btn-success">New Booking</a>
</p>
<table class="table table-striped table-sm">
    <thead>
        <tr>
            <th>Equipment</th>
            <th>start</th>
            <th>end</th>
            <th>price</th>
            <th>status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EquipmentName</td>
                <td>@item.StartDate.ToString("g")</td>
                <td>@item.EndDate.ToString("g")</td>
                <td>@item.TotalPrice.ToString("0.00")</td>
                <td>@item.Status</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>