
@model CreateRentalViewModel
@{
    ViewData["Title"] = "create booking";

}
<h2>@ViewData["Title"]</h2>
<div>
    <h4>@Model.EquipmentName</h4>
    <p>Ціна за годину: @Model.PricePerHour</p>
</div>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EquipmentId" />


    <div class="form-group">
        <label asp-for="StartDate">start date time</label>
        <input asp-for="StartDate" class="form-control" type="datetime-local" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>


    <div class="form-group">
        <label asp-for="EndDate">end date time</label>
        <input asp-for="EndDate" class="form-control" type="datetime-local" value="@Model.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>


    <div class="form-group mt-2">
        <button type="submit" class="btn btn-primary">book</button>
        <a asp-controller="Equipment" asp-action="Index" class="btn btn-secondary">back</a>
    </div>
</form>
