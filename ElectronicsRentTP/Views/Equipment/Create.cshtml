@model BusinessLogic.Dtos.EquipmentDTO

<style>
    .form-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .form-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .form-title {
        font-size: 2rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
    }

    .form-subtitle {
        color: #718096;
        font-size: 1.05rem;
    }

    .form-card {
        background: white;
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .validation-errors {
        background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
        border-left: 4px solid #ef4444;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }

    .validation-errors h4 {
        color: #991b1b;
        font-weight: 700;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .validation-errors ul {
        margin: 0;
        padding-left: 1.5rem;
    }

    .validation-errors li {
        color: #7f1d1d;
        margin-bottom: 0.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #2d3748;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label i {
        color: #667eea;
    }

    .form-control,
    .form-select {
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        outline: none;
    }

    .form-text {
        color: #718096;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .form-text i {
        color: #667eea;
    }

    .text-danger {
        color: #ef4444 !important;
        font-size: 0.875rem;
        margin-top: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .text-danger::before {
        content: "⚠";
        font-size: 1rem;
    }

    .form-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 2px solid #f7fafc;
    }

    .btn-back {
        background: white;
        color: #718096;
        border: 2px solid #e2e8f0;
        padding: 1rem 2rem;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
    }

    .btn-back:hover {
        background: #f7fafc;
        color: #2d3748;
        border-color: #cbd5e0;
        transform: translateX(-4px);
    }

    .btn-submit {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 1rem 2rem;
        border-radius: 10px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
    }

    .input-group-text {
        background: #f7fafc;
        border: 2px solid #e2e8f0;
        color: #667eea;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .form-card {
            padding: 1.5rem;
        }

        .form-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h1 class="form-title">➕ Add New Equipment</h1>
        <p class="form-subtitle">Fill in the details to add equipment to your inventory</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-errors">
            <h4>
                <i class="bi bi-exclamation-triangle"></i>
                Validation Errors
            </h4>
            <ul>
                @foreach (var error in ViewData.ModelState)
                {
                    @foreach (var message in error.Value.Errors)
                    {
                        <li><strong>@error.Key:</strong> @message.ErrorMessage</li>
                    }
                }
            </ul>
        </div>
    }

    <div class="form-card">
        <form class="row g-4" asp-action="Create" method="post" asp-controller="Equipment">
            @Html.AntiForgeryToken()

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">
                    <i class="bi bi-tag"></i>
                    Equipment Name
                </label>
                <input asp-for="Name" type="text" class="form-control" placeholder="e.g., MacBook Pro 16-inch">
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label">
                    <i class="bi bi-folder"></i>
                    Category
                </label>
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select">
                    <option value="">Choose category...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PricePerHour" class="form-label">
                    <i class="bi bi-currency-dollar"></i>
                    Price per Hour
                </label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="PricePerHour" type="number" step="0.01" min="0" class="form-control" placeholder="0.00">
                </div>
                <span asp-validation-for="PricePerHour" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Quantity" class="form-label">
                    <i class="bi bi-box-seam"></i>
                    Quantity
                </label>
                <input asp-for="Quantity" type="number" min="0" class="form-control" placeholder="0">
                <span asp-validation-for="Quantity" class="text-danger"></span>
                <small class="form-text">
                    <i class="bi bi-info-circle"></i>
                    Status will be automatically set to Available if quantity > 0
                </small>
            </div>

            <div class="col-md-12">
                <label asp-for="ImageUrl" class="form-label">
                    <i class="bi bi-image"></i>
                    Image URL
                </label>
                <input asp-for="ImageUrl" type="url" class="form-control" placeholder="https://example.com/image.jpg">
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="Description" class="form-label">
                    <i class="bi bi-text-paragraph"></i>
                    Description
                </label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter detailed description of the equipment..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-actions col-12">
                <a asp-action="Index" class="btn-back">
                    <i class="bi bi-arrow-left"></i>
                    Back to List
                </a>
                <button type="submit" class="btn-submit">
                    <i class="bi bi-plus-circle"></i>
                    Add Equipment
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}