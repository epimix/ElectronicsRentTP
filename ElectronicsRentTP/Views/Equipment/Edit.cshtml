@model Equipment

<h1>Edit Equipment</h1>

<form class="row g-3" asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" value="@Model.Id" />
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">Equipment Name</label>
        <input asp-for="Name" type="text" class="form-control" placeholder="Enter equipment name">
        <span asp-validation-for="Name" class="small text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="form-select">
            <option disabled selected>Choose category...</option>
        </select>
        <span asp-validation-for="CategoryId" class="small text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="PricePerHour" class="form-label">Price per Hour ($)</label>
        <input asp-for="PricePerHour" type="number" step="0.01" min="0" class="form-control" placeholder="Price">
        <span asp-validation-for="PricePerHour" class="small text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Quantity" class="form-label">Quantity</label>
        <input asp-for="Quantity" type="number" min="0" class="form-control" placeholder="Quantity">
        <span asp-validation-for="Quantity" class="small text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="IsAvailable" class="form-label">Available</label>
        <select asp-for="IsAvailable" class="form-select">
            <option value="True" selected="@Model.IsAvailable">Yes</option>
            <option value="False" selected="@(!Model.IsAvailable)">No</option>
        </select>
        <span asp-validation-for="IsAvailable" class="small text-danger"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="ImageUrl" class="form-label">Image URL</label>
        <input asp-for="ImageUrl" type="url" class="form-control" placeholder="Enter image URL">
        <span asp-validation-for="ImageUrl" class="small text-danger"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">Description</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description"></textarea>
        <span asp-validation-for="Description" class="small text-danger"></span>
    </div>

    <div class="col-6">
        <a asp-action="Index" class="btn btn-dark w-100">Back</a>
    </div>
    <div class="col-6">
        <button type="submit" class="btn btn-success w-100">Save</button>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
